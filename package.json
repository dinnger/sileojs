{
  "name": "sileojs",
  "version": "0.1.10",
  "description": "Toast notifications for JavaScript with gooey morphing and spring physics. Zero-dependency vanilla JS core that works with any framework (React, Svelte, Angular), plus a Vue 3 adapter. All animation in pure CSS.",
  "type": "module",
  "main": "./src/sileo.js",
  "exports": {
    ".": "./src/sileo.js",
    "./vue": "./src/vue.js",
    "./styles.css": "./src/sileo.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/sileo.css"
  ],
  "keywords": [
    "toast",
    "toasts",
    "toaster",
    "toast-notification",
    "toast-notifications",
    "notification",
    "notifications",
    "notificaciones",
    "snackbar",
    "alert",
    "sonner",
    "sileo",
    "sileojs",
    "vanilla-js",
    "javascript",
    "vue",
    "vue3",
    "vue-toast",
    "react",
    "react-toast",
    "svelte",
    "angular",
    "css-animation",
    "animation",
    "spring",
    "spring-physics",
    "gooey",
    "metaballs",
    "morphing",
    "ui",
    "component",
    "zero-dependencies"
  ],
  "homepage": "https://dinnger.github.io/sileojs/docs/en.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinnger/sileojs.git"
  },
  "bugs": {
    "url": "https://github.com/dinnger/sileojs/issues"
  },
  "author": "Walter Omar (https://github.com/dinnger)",
  "license": "MIT"
}
