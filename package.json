{
  "name": "sileojs",
  "version": "0.1.6",
  "description": "Toast notificaciones con morphing gooey y spring physics. Core vanilla JS (cero dependencias) + adaptador Vue 3. Toda la animacion en CSS.",
  "type": "module",
  "main": "./src/sileo.js",
  "exports": {
    ".": "./src/sileo.js",
    "./vue": "./src/vue.js",
    "./styles.css": "./src/sileo.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/sileo.css"
  ],
  "keywords": [
    "toast",
    "notification",
    "notificaciones",
    "vanilla-js",
    "vue",
    "vue3",
    "react",
    "svelte",
    "css-animation",
    "spring",
    "gooey",
    "metaballs",
    "zero-dependencies"
  ],
  "homepage": "https://dinnger.github.io/sileojs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinnger/sileojs.git"
  },
  "bugs": {
